VITE_API_ENDPOINT=https://referral-sdk-node.vercel.app/api

# Full store listing URLs — set directly rather than composed from a bare
# package name/app id, so a code deploy is never needed to fix a wrong or
# missing store link. Leaving either one unset falls back to the
# (currently placeholder, not real) androidPackage/iosAppId in App.tsx.
#
# iosStoreUrl in particular should be the full regioned URL
# (apps.apple.com/<country>/app/<slug>/id<id>), not a bare id-only link —
# see docs/decisions.md #16 for why that's more than cosmetic.
VITE_IOS_STORE_URL=
VITE_ANDROID_STORE_URL=
