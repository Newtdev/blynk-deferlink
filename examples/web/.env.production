# Point this at your own deployed backend — see docs/integration/referral-sdk.md
# or referral-sdk-node.md. Placeholder below is not a real deployment.
VITE_API_ENDPOINT=https://your-backend.example.com/api

# Full store listing URLs — set directly rather than composed from a bare
# package name/app id, so a code deploy is never needed to fix a wrong or
# missing store link. Leaving either one unset falls back to the
# (currently placeholder, not real) androidPackage/iosAppId in App.tsx.
#
# iosStoreUrl in particular should be the full regioned URL
# (apps.apple.com/<country>/app/<slug>/id<id>), not a bare id-only link —
# see docs/decisions.md #16 for why that's more than cosmetic. Placeholders
# below are not a real app listing.
VITE_IOS_STORE_URL=https://apps.apple.com/us/app/your-app/id0000000000
VITE_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.example.yourapp
