# Neon connection string. From the Neon dashboard: Project → Connect →
# "Pooled connection" works fine too, since @neondatabase/serverless talks
# HTTP either way. Looks like:
#   postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Local/standalone server port (ignored on Vercel).
PORT=8787

# Required, not optional — signs every click token. Generate with
# `openssl rand -hex 32`. /click and /match throw a clear error at request
# time if this is unset, rather than silently minting tokens no one can
# ever verify. See docs/decisions.md #21/#22.
CLICK_TOKEN_SECRET=

# Secret required to call POST/GET /api/referral/cleanup. Leave unset to
# disable the endpoint entirely (it refuses all requests without it).
CRON_SECRET=

# Secret required to call GET /api/referral/analytics. Leave unset to
# disable the endpoint entirely (it refuses all requests without it).
ANALYTICS_SECRET=

# Reverse-proxy hop count to trust for clientIp() (IP-match scoring,
# per-IP rate limiting). Defaults to 0 — trust nothing, safest default,
# but degrades IP-based signals to whatever's directly in front of this
# process. Set to 1 on Vercel specifically (its edge is exactly one hop);
# a self-hosted deploy behind its own reverse proxy needs that proxy's
# actual hop count instead. See docs/decisions.md #23.
TRUST_PROXY_HOPS=0

# --- Optional referral tuning (see src/configFromEnv.ts for defaults) ------
# REFERRAL_MATCH_WINDOW_HOURS=48
# REFERRAL_MIN_CONFIDENCE=70
# REFERRAL_RATE_LIMIT_CLICKS_PER_HOUR=10
# REFERRAL_RATE_LIMIT_MATCHES_PER_DAY=5
# REFERRAL_RATE_LIMIT_CLAIMS_PER_HOUR=10
# REFERRAL_HASH_DEVICE_IDS=true
# REFERRAL_REWARDS_ENABLED=true
# REFERRAL_REFERRER_REWARD=500
# REFERRAL_REFEREE_REWARD=500
# REFERRAL_REWARD_TYPE=credit
# How long /cleanup keeps referral_match_attempts/referral_rate_limit_hits
# rows before purging (days). Both grew unbounded forever before this.
# REFERRAL_RETENTION_DAYS=30
