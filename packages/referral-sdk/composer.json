{
    "name": "blynk-deferlink/referral-sdk",
    "description": "Deferred deep linking referral SDK — click storage, fingerprint matching, and conversion tracking. Framework-agnostic core with optional Laravel integration.",
    "type": "library",
    "license": "MIT",
    "keywords": ["referral", "deep-linking", "deferred", "install-referrer", "fingerprint", "attribution"],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/http": "^10.0|^11.0",
        "illuminate/database": "^10.0|^11.0",
        "illuminate/console": "^10.0|^11.0"
    },
    "suggest": {
        "illuminate/support": "Required only for the Laravel integration (ServiceProvider, controllers, artisan command)."
    },
    "autoload": {
        "psr-4": {
            "BlynkDeferlink\\Referral\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BlynkDeferlink\\Referral\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BlynkDeferlink\\Referral\\ReferralServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
